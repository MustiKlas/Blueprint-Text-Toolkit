"""Gerçek bir Blueprint'ten (UpdateLoadedChunks) çıkan durumların sentetik kopyası."""
from app.outputs import build_medium, build_short
from app.report import build_report, node_category
from tests.builder import hexid as h, node, pin


def make_text():
    n = []
    n.append(node("K2Node_FunctionEntry", "K2Node_FunctionEntry_0",
        '   FunctionReference=(MemberName="Update")', [
        pin(h("E", 1), "then", "exec", out=True, linked=f"K2Node_IfThenElse_0 {h('B', 1)}"),
        pin(h("E", 2), "Count", "int", out=True, linked=f"K2Node_PromotableOperator_0 {h('A', 1)}")]))
    n.append(node("K2Node_IfThenElse", "K2Node_IfThenElse_0", "", [
        pin(h("B", 1), "execute", "exec", linked=f"K2Node_FunctionEntry_0 {h('E', 1)}"),
        pin(h("B", 2), "Condition", "bool", default="true", linked=f"K2Node_PromotableOperator_0 {h('A', 3)}"),
        pin(h("B", 3), "then", "exec", out=True, friendly="true", linked=f"K2Node_VariableSet_0 {h('C', 1)}"),
        pin(h("B", 4), "else", "exec", out=True, friendly="false")]))
    # B girişinde yalnızca AutogeneratedDefaultValue var (gerçek veride görülen durum)
    n.append(node("K2Node_PromotableOperator", "K2Node_PromotableOperator_0",
        '   OperationName="Greater"\n   FunctionReference=(MemberName="Greater_IntInt")', [
        pin(h("A", 1), "A", "int", linked=f"K2Node_FunctionEntry_0 {h('E', 2)}"),
        pin(h("A", 2), "B", "int", auto="0"),
        pin(h("A", 3), "ReturnValue", "bool", out=True, linked=f"K2Node_IfThenElse_0 {h('B', 2)}"),
        pin(h("A", 4), "ErrorTolerance", "real", sub="double", hidden=True)]))
    n.append(node("K2Node_VariableSet", "K2Node_VariableSet_0",
        '   VariableReference=(MemberName="PlayerChunk")', [
        pin(h("C", 1), "execute", "exec", linked=f"K2Node_IfThenElse_0 {h('B', 3)}"),
        pin(h("C", 2), "then", "exec", out=True),
        pin(h("C", 3), "PlayerChunk", "struct", default="(Q=0,R=0)"),
        pin(h("C", 4), "Output_Get_Q", "int", out=True, linked=f"K2Node_PromotableOperator_1 {h('D', 1)}")]))
    n.append(node("K2Node_VariableGet", "K2Node_VariableGet_0",
        '   VariableReference=(MemberName="CurrentChunk",bSelfContext=True)', [
        pin(h("F", 1), "CurrentChunk_Q", "int", out=True, linked=f"K2Node_PromotableOperator_1 {h('D', 2)}")]))
    n.append(node("K2Node_PromotableOperator", "K2Node_PromotableOperator_1",
        '   OperationName="EqualEqual"\n   FunctionReference=(MemberName="EqualEqual_IntInt")', [
        pin(h("D", 1), "A", "int", linked=f"K2Node_VariableSet_0 {h('C', 4)}"),
        pin(h("D", 2), "B", "int", linked=f"K2Node_VariableGet_0 {h('F', 1)}"),
        pin(h("D", 3), "ReturnValue", "bool", out=True)]))
    n.append(node("K2Node_CallFunction", "K2Node_CallFunction_0",
        '   FunctionReference=(MemberName="DoWork")', [
        pin(h("9", 1), "execute", "exec"),
        pin(h("9", 2), "then", "exec", out=True),
        pin(h("9", 3), "self", "object", sub="self")]))
    return "".join(n)


def test_autogenerated_default_is_not_reported_missing():
    report = build_report(make_text())
    assert not any("Missing input" in i for i in report.issues)
    greater = next(n for n in report.nodes if n.label == "Greater")
    b = next(p for p in greater.pins if p.name == "B")
    assert b.default == "0"


def test_exec_lines_use_clean_pin_names():
    text = build_medium(build_report(make_text()))
    assert "NSLOCTEXT" not in text
    assert "then (true)" in text


def test_variable_members_are_resolved():
    report = build_report(make_text())
    equal = next(n for n in report.nodes if n.label == "EqualEqual")
    out = next(p for p in equal.pins if p.name == "ReturnValue")
    assert report.expression(equal, out) == "(PlayerChunk.Q == this->CurrentChunk.Q)"


def test_new_node_kinds():
    assert node_category("K2Node_CommutativeAssociativeBinaryOperator")[0] == "operator"
    assert node_category("K2Node_CallArrayFunction")[0] == "call"


def test_implicit_self_is_this():
    report = build_report(make_text())
    call = next(n for n in report.nodes if n.category == "call")
    self_pin = next(p for p in call.pins if p.name == "self" or p.is_implicit_self)
    assert report.input_ref(self_pin) == "this"


def test_short_output_lists_effects_for_void_function():
    text = build_short(build_report(make_text()))
    assert "void" in text
    assert "Dallanma: (Count > 0)" in text
    assert "PlayerChunk = (Q=0,R=0)" in text
